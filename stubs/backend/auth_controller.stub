<?php

namespace Modules\{{MODULE_NAME}}\Http\Controllers;

use Illuminate\Http\Request;
use Illuminate\Http\Response;
use Illuminate\Support\Facades\Hash;
use Modules\{{MODULE_NAME}}\Models\{{MODEL_NAME}};

class AuthController
{
    /**
     * 前端入口
     * 读取 index.html 并注入后台配置
     */
    public function entry(): Response
    {
        $config = config('{{LOWER_NAME}}.backend', []);
        // 所有后台共享 public/admin/ 前端资源
        $indexPath = public_path('admin/index.html');

        if (!file_exists($indexPath)) {
            abort(404, '前端资源未发布');
        }

        $html = file_get_contents($indexPath);

        // 构建注入的配置（只返回前端必需的公开信息）
        $entryConfig = [
            'apiPrefix' => '/' . ltrim($config['api_prefix'] ?? 'api/{{LOWER_NAME}}', '/'),
            'appTitle' => $config['app_title'] ?? '{{APP_TITLE}}',
            'logo' => $config['logo'] ?? config('lartrix.logo'),
        ];
        $script = '<script>window.__LARTRIX_CONFIG__ = ' . json_encode($entryConfig, JSON_UNESCAPED_UNICODE) . ';</script>';

        // 注入到 <head> 中
        $html = str_replace('<head>', '<head>' . "\n    " . $script, $html);

        return response($html)->header('Content-Type', 'text/html');
    }

    /**
     * 用户登录
     */
    public function login(Request $request): array
    {
        $request->validate([
            'username' => 'required|string',
            'password' => 'required|string',
        ]);

        $user = {{MODEL_NAME}}::where('username', $request->input('username'))->first();

        if (!$user || !Hash::check($request->input('password'), $user->password)) {
            error('用户名或密码错误', null, 40001);
        }

        if (!$user->status) {
            error('账号已被禁用', null, 40003);
        }

        $token = $user->createToken('{{LOWER_NAME}}-token');

        return success('登录成功', [
            'token' => $token->plainTextToken,
        ]);
    }

    /**
     * 用户登出
     */
    public function logout(Request $request): array
    {
        $request->user()->currentAccessToken()->delete();
        return success('登出成功');
    }

    /**
     * 刷新 Token
     */
    public function refresh(Request $request): array
    {
        $user = $request->user();
        $user->currentAccessToken()->delete();
        $token = $user->createToken('{{LOWER_NAME}}-token');

        return success('刷新成功', [
            'token' => $token->plainTextToken,
        ]);
    }

    /**
     * 获取当前用户信息
     */
    public function user(Request $request): array
    {
        $user = $request->user();

        return success([
            'id' => $user->id,
            'username' => $user->username,
            'nickname' => $user->nickname,
            'avatar' => $user->avatar,
            'email' => $user->email,
            'phone' => $user->phone,
            'status' => $user->status,
            'roles' => $user->getRoleNames(),
            'permissions' => $user->getActivePermissions()->pluck('name'),
            'locale' => $user->locale ?: config('lartrix.locale', 'zh-CN'),
        ]);
    }

    /**
     * 个人资料弹窗 UI Schema
     * GET /user/profile/ui
     */
    public function profileUi(Request $request): array
    {
        $user = $request->user();

        $form = \Lartrix\Schema\Components\Business\OptForm::make('formData')
            ->fields([
                ['用户名', 'username', \Lartrix\Schema\Components\NaiveUI\Input::make()->props(['disabled' => true, 'placeholder' => '用户名'])],
                ['昵称', 'nickname', \Lartrix\Schema\Components\NaiveUI\Input::make()->props(['placeholder' => '请输入昵称']), $user->nickname ?? ''],
                ['邮箱', 'email', \Lartrix\Schema\Components\NaiveUI\Input::make()->props(['placeholder' => '请输入邮箱']), $user->email ?? ''],
                ['手机号', 'phone', \Lartrix\Schema\Components\NaiveUI\Input::make()->props(['placeholder' => '请输入手机号']), $user->phone ?? ''],
                ['头像', 'avatar', \Lartrix\Schema\Components\NaiveUI\Input::make()->props(['placeholder' => '头像 URL']), $user->avatar ?? ''],
            ])
            ->buttons([
                \Lartrix\Schema\Components\NaiveUI\Button::make()->on('click', \Lartrix\Schema\Actions\EmitAction::make('close'))->text('取消'),
                \Lartrix\Schema\Components\NaiveUI\Button::make()->type('primary')->on('click', \Lartrix\Schema\Actions\EmitAction::make('submit'))->text('保存'),
            ]);

        return success($form->toArray());
    }

    /**
     * 保存个人资料
     * POST /user/profile
     */
    public function profile(Request $request): array
    {
        $user = $request->user();

        $validated = $request->validate([
            'nickname' => 'nullable|string|max:20',
            'email' => 'nullable|email|max:255',
            'phone' => 'nullable|string|max:20',
            'avatar' => 'nullable|string|max:255',
        ]);

        $user->fill($validated);
        $user->save();

        return success('保存成功');
    }

    /**
     * 账号设置弹窗 UI Schema
     * GET /user/settings/ui
     */
    public function settingsUi(Request $request): array
    {
        $user = $request->user();
        $locale = $user->locale ?: config('lartrix.locale', 'zh-CN');

        $form = \Lartrix\Schema\Components\Business\OptForm::make('formData')
            ->fields([
                ['语言', 'locale', \Lartrix\Schema\Components\NaiveUI\Select::make()->props([
                    'placeholder' => '请选择语言',
                    'options' => [
                        ['label' => '中文', 'value' => 'zh-CN'],
                        ['label' => 'English', 'value' => 'en-US'],
                    ],
                ]), $locale],
            ])
            ->buttons([
                \Lartrix\Schema\Components\NaiveUI\Button::make()->on('click', \Lartrix\Schema\Actions\EmitAction::make('close'))->text('取消'),
                \Lartrix\Schema\Components\NaiveUI\Button::make()->type('primary')->on('click', \Lartrix\Schema\Actions\EmitAction::make('submit'))->text('保存'),
            ]);

        return success($form->toArray());
    }

    /**
     * 保存账号设置
     * POST /user/settings
     */
    public function settings(Request $request): array
    {
        $user = $request->user();

        $validated = $request->validate([
            'locale' => 'nullable|string|max:20',
        ]);

        if (!empty($validated['locale'])) {
            $user->locale = $validated['locale'];
            $user->save();
        }

        return success('保存成功');
    }

    /**
     * 修改密码弹窗 UI Schema
     * GET /user/password/ui
     */
    public function passwordUi(): array
    {
        $form = \Lartrix\Schema\Components\Business\OptForm::make('formData')
            ->fields([
                ['当前密码', 'current_password', \Lartrix\Schema\Components\NaiveUI\Input::make()->props(['type' => 'password', 'showPasswordOn' => 'click', 'placeholder' => '请输入当前密码'])],
                ['新密码', 'new_password', \Lartrix\Schema\Components\NaiveUI\Input::make()->props(['type' => 'password', 'showPasswordOn' => 'click', 'placeholder' => '请输入新密码（至少 6 位）'])],
                ['确认新密码', 'new_password_confirmation', \Lartrix\Schema\Components\NaiveUI\Input::make()->props(['type' => 'password', 'showPasswordOn' => 'click', 'placeholder' => '请再次输入新密码'])],
            ])
            ->buttons([
                \Lartrix\Schema\Components\NaiveUI\Button::make()->on('click', \Lartrix\Schema\Actions\EmitAction::make('close'))->text('取消'),
                \Lartrix\Schema\Components\NaiveUI\Button::make()->type('primary')->on('click', \Lartrix\Schema\Actions\EmitAction::make('submit'))->text('保存'),
            ]);

        return success($form->toArray());
    }

    /**
     * 修改当前用户密码
     * POST /user/password
     */
    public function password(Request $request): array
    {
        $user = $request->user();

        $validated = $request->validate([
            'current_password' => 'required|string',
            'new_password' => 'required|string|min:6|confirmed',
        ]);

        if (!\Illuminate\Support\Facades\Hash::check($validated['current_password'], $user->password)) {
            error('当前密码不正确', null, 40022);
        }

        $user->password = \Illuminate\Support\Facades\Hash::make($validated['new_password']);
        $user->save();

        return success('密码修改成功，请重新登录');
    }

    /**
     * 获取后台配置（API 接口）
     * 注意：只返回前端必需的公开信息
     */
    public function config(): array
    {
        $config = config('{{LOWER_NAME}}.backend', []);

        return success([
            'apiPrefix' => '/' . ltrim($config['api_prefix'] ?? 'api/{{LOWER_NAME}}', '/'),
            'appTitle' => $config['app_title'] ?? '{{APP_TITLE}}',
            'logo' => $config['logo'] ?? config('lartrix.logo'),
        ]);
    }
}
