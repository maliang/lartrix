<?php

namespace Modules\{{MODULE_NAME}}\Http\Controllers;

use Illuminate\Http\Request;
use Illuminate\Http\Response;
use Illuminate\Support\Facades\Hash;
use Modules\{{MODULE_NAME}}\Models\{{MODEL_NAME}};

class AuthController
{
    /**
     * 前端入口
     * 读取 index.html 并注入后台配置
     */
    public function entry(): Response
    {
        $config = config('{{LOWER_NAME}}.backend', []);
        $path = $config['path'] ?? '/{{LOWER_NAME}}';
        $publicPath = ltrim($path, '/') ?: '{{LOWER_NAME}}';
        $indexPath = public_path($publicPath . '/index.html');

        if (!file_exists($indexPath)) {
            abort(404, '前端资源未发布');
        }

        $html = file_get_contents($indexPath);

        // 构建注入的配置（只返回前端必需的公开信息）
        $entryConfig = [
            'apiPrefix' => '/' . ltrim($config['api_prefix'] ?? 'api/{{LOWER_NAME}}', '/'),
            'appTitle' => $config['app_title'] ?? '{{APP_TITLE}}',
            'logo' => $config['logo'] ?? config('lartrix.logo'),
        ];
        $script = '<script>window.__LARTRIX_CONFIG__ = ' . json_encode($entryConfig, JSON_UNESCAPED_UNICODE) . ';</script>';

        // 注入到 <head> 中
        $html = str_replace('<head>', '<head>' . "\n    " . $script, $html);

        return response($html)->header('Content-Type', 'text/html');
    }

    /**
     * 用户登录
     */
    public function login(Request $request): array
    {
        $request->validate([
            'username' => 'required|string',
            'password' => 'required|string',
        ]);

        $user = {{MODEL_NAME}}::where('username', $request->input('username'))->first();

        if (!$user || !Hash::check($request->input('password'), $user->password)) {
            return $this->error('用户名或密码错误', null, 40001);
        }

        if (!$user->status) {
            return $this->error('账号已被禁用', null, 40003);
        }

        $token = $user->createToken('{{LOWER_NAME}}-token');

        return $this->success('登录成功', [
            'token' => $token->plainTextToken,
        ]);
    }

    /**
     * 用户登出
     */
    public function logout(Request $request): array
    {
        $request->user()->currentAccessToken()->delete();
        return $this->success('登出成功');
    }

    /**
     * 刷新 Token
     */
    public function refresh(Request $request): array
    {
        $user = $request->user();
        $user->currentAccessToken()->delete();
        $token = $user->createToken('{{LOWER_NAME}}-token');

        return $this->success('刷新成功', [
            'token' => $token->plainTextToken,
        ]);
    }

    /**
     * 获取当前用户信息
     */
    public function user(Request $request): array
    {
        $user = $request->user();

        return $this->success([
            'id' => $user->id,
            'username' => $user->username,
            'nickname' => $user->nickname,
            'avatar' => $user->avatar,
            'email' => $user->email,
            'phone' => $user->phone,
            'status' => $user->status,
            'roles' => $user->getRoleNames(),
            'permissions' => $user->getActivePermissions()->pluck('name'),
        ]);
    }

    /**
     * 获取后台配置（API 接口）
     * 注意：只返回前端必需的公开信息
     */
    public function config(): array
    {
        $config = config('{{LOWER_NAME}}.backend', []);

        return $this->success([
            'apiPrefix' => '/' . ltrim($config['api_prefix'] ?? 'api/{{LOWER_NAME}}', '/'),
            'appTitle' => $config['app_title'] ?? '{{APP_TITLE}}',
            'logo' => $config['logo'] ?? config('lartrix.logo'),
        ]);
    }

    /**
     * 成功响应
     */
    protected function success($data = null, ?string $message = null): array
    {
        if (is_string($data)) {
            $message = $data;
            $data = null;
        }

        return [
            'success' => true,
            'message' => $message,
            'data' => $data,
        ];
    }

    /**
     * 错误响应
     */
    protected function error(string $message, $data = null, int $code = 400): array
    {
        return [
            'success' => false,
            'message' => $message,
            'data' => $data,
            'code' => $code,
        ];
    }
}
