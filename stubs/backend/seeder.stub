<?php

namespace Modules\{{MODULE_NAME}}\Database\Seeders;

use Illuminate\Database\Seeder;
use Illuminate\Support\Facades\Hash;
use Spatie\Permission\Models\Role;
use Spatie\Permission\Models\Permission;

class {{MODULE_NAME}}BackendSeeder extends Seeder
{
    /**
     * Run the database seeds.
     */
    public function run(): void
    {
        $guard = '{{GUARD}}';
        $modelClass = \Modules\{{MODULE_NAME}}\Models\{{MODEL_NAME}}::class;
        $menuModel = config('lartrix.models.menu', \Lartrix\Models\Menu::class);

        // 创建默认菜单
        $this->createMenus($menuModel, $guard);

        // 创建默认权限
        $this->createPermissions($guard);

        // 创建默认通知分类
        $this->createNotificationCategories($guard);

        // 创建超级管理员角色
        $role = Role::firstOrCreate(
            ['name' => 'super-admin', 'guard_name' => $guard],
            [
                'name' => 'super-admin',
                'title' => '超级管理员',
                'description' => '拥有所有权限的超级管理员角色',
                'guard_name' => $guard,
                'is_system' => true,
                'status' => true,
            ]
        );

        // 创建默认管理员账号
        $admin = $modelClass::firstOrCreate(
            ['username' => 'admin'],
            [
                'username' => 'admin',
                'password' => Hash::make('123456'),
                'nickname' => '超级管理员',
                'status' => true,
            ]
        );

        // 分配角色
        if (!$admin->hasRole('super-admin')) {
            $admin->assignRole($role);
        }
    }

    /**
     * 创建默认菜单
     */
    protected function createMenus($menuModel, string $guard): void
    {
        $menus = [
            [
                'guard_name' => $guard,
                'name' => 'home',
                'path' => '/home',
                'title' => '首页',
                'icon' => 'mdi:home',
                'order' => 1,
                'use_json_renderer' => true,
                'schema_source' => '/dashboard',
            ],
            [
                'guard_name' => $guard,
                'name' => 'system',
                'path' => '/system',
                'redirect' => '/system/user',
                'title' => '系统管理',
                'icon' => 'mdi:cog',
                'order' => 9999,
                'children' => [
                    [
                        'guard_name' => $guard,
                        'name' => 'system.menu',
                        'path' => 'menu',
                        'title' => '菜单管理',
                        'icon' => 'mdi:menu',
                        'order' => 1,
                        'use_json_renderer' => true,
                        'schema_source' => '/menus?action_type=list_ui',
                    ],
                    [
                        'guard_name' => $guard,
                        'name' => 'system.role',
                        'path' => 'role',
                        'title' => '角色管理',
                        'icon' => 'mdi:account-key',
                        'order' => 2,
                        'use_json_renderer' => true,
                        'schema_source' => '/roles?action_type=list_ui',
                    ],
                    [
                        'guard_name' => $guard,
                        'name' => 'system.permission',
                        'path' => 'permission',
                        'title' => '权限管理',
                        'icon' => 'mdi:shield-key',
                        'order' => 3,
                        'use_json_renderer' => true,
                        'schema_source' => '/permissions?action_type=list_ui',
                    ],
                    [
                        'guard_name' => $guard,
                        'name' => 'system.user',
                        'path' => 'user',
                        'title' => '管理员管理',
                        'icon' => 'mdi:account-group',
                        'order' => 4,
                        'use_json_renderer' => true,
                        'schema_source' => '/users?action_type=list_ui',
                    ],
                ],
            ],
        ];

        foreach ($menus as $menu) {
            $this->createMenu($menuModel, $menu);
        }
    }

    /**
     * 递归创建菜单
     */
    protected function createMenu($menuModel, array $data, ?int $parentId = null): void
    {
        $children = $data['children'] ?? [];
        unset($data['children']);

        $data['parent_id'] = $parentId;

        $menu = $menuModel::firstOrCreate(
            ['name' => $data['name'], 'guard_name' => $data['guard_name']],
            $data
        );

        foreach ($children as $child) {
            $this->createMenu($menuModel, $child, $menu->id);
        }
    }

    /**
     * 创建默认权限
     */
    protected function createPermissions(string $guard): void
    {
        $groups = [
            [
                'name' => 'system.menu', 'title' => '菜单管理', 'module' => 'system',
                'children' => [
                    ['name' => 'system.menu.list', 'title' => '菜单列表', 'module' => 'system'],
                    ['name' => 'system.menu.create', 'title' => '创建菜单', 'module' => 'system'],
                    ['name' => 'system.menu.update', 'title' => '编辑菜单', 'module' => 'system'],
                    ['name' => 'system.menu.delete', 'title' => '删除菜单', 'module' => 'system'],
                ],
            ],
            [
                'name' => 'system.role', 'title' => '角色管理', 'module' => 'system',
                'children' => [
                    ['name' => 'system.role.list', 'title' => '角色列表', 'module' => 'system'],
                    ['name' => 'system.role.create', 'title' => '创建角色', 'module' => 'system'],
                    ['name' => 'system.role.update', 'title' => '编辑角色', 'module' => 'system'],
                    ['name' => 'system.role.delete', 'title' => '删除角色', 'module' => 'system'],
                ],
            ],
            [
                'name' => 'system.permission', 'title' => '权限管理', 'module' => 'system',
                'children' => [
                    ['name' => 'system.permission.list', 'title' => '权限列表', 'module' => 'system'],
                    ['name' => 'system.permission.sync', 'title' => '同步权限', 'module' => 'system'],
                ],
            ],
            [
                'name' => 'system.user', 'title' => '管理员管理', 'module' => 'system',
                'children' => [
                    ['name' => 'system.user.list', 'title' => '管理员列表', 'module' => 'system'],
                    ['name' => 'system.user.create', 'title' => '创建管理员', 'module' => 'system'],
                    ['name' => 'system.user.update', 'title' => '编辑管理员', 'module' => 'system'],
                    ['name' => 'system.user.delete', 'title' => '删除管理员', 'module' => 'system'],
                ],
            ],
        ];

        foreach ($groups as $group) {
            $this->createPermission($guard, $group);
        }
    }

    /**
     * 递归创建权限
     */
    protected function createPermission(string $guard, array $data, ?int $parentId = null): void
    {
        $children = $data['children'] ?? [];
        unset($data['children']);

        $permission = Permission::firstOrCreate(
            ['name' => $data['name'], 'guard_name' => $guard],
            [
                'name' => $data['name'],
                'title' => $data['title'] ?? null,
                'module' => $data['module'] ?? null,
                'guard_name' => $guard,
                'parent_id' => $parentId,
                'sort' => 0,
            ]
        );

        foreach ($children as $child) {
            $this->createPermission($guard, $child, $permission->id);
        }
    }

    /**
     * 创建默认通知分类
     */
    protected function createNotificationCategories(string $guard): void
    {
        $categoryModel = config('lartrix.notification.category_model', \Lartrix\Models\NotificationCategory::class);
        $defaultCategories = config('lartrix.notification.default_categories', []);

        foreach ($defaultCategories as $category) {
            $categoryModel::firstOrCreate(
                [
                    'key' => $category['key'],
                    'guard_name' => $guard,
                ],
                [
                    'name' => $category['name'],
                    'icon' => $category['icon'] ?? null,
                    'color' => $category['color'] ?? null,
                    'message_types' => $category['message_types'] ?? [],
                    'sort' => $category['sort'] ?? 0,
                    'enabled' => true,
                ]
            );
        }

        $this->command->info("   已创建默认通知分类。");
    }
}
