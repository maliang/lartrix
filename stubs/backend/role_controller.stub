<?php

namespace Modules\{{MODULE_NAME}}\Http\Controllers;

use Illuminate\Http\Request;
use Illuminate\Database\Eloquent\Builder;
use Lartrix\Controllers\RoleController as BaseRoleController;

class RoleController extends BaseRoleController
{
    protected function getGuard(): string
    {
        return config('{{LOWER_NAME}}.backend.guard', '{{GUARD}}');
    }

    /**
     * 按 guard 过滤角色列表
     */
    protected function applySearch(Builder $query, Request $request): void
    {
        $query->where('guard_name', $this->getGuard());

        if ($keyword = $request->input('keyword')) {
            $query->where(function ($q) use ($keyword) {
                $q->where('name', 'like', "%{$keyword}%")
                    ->orWhere('title', 'like', "%{$keyword}%");
            });
        }
    }

    /**
     * 创建时自动设置 guard_name
     */
    protected function prepareStoreData(array $validated): array
    {
        return [
            'name' => $validated['name'],
            'title' => $validated['title'] ?? null,
            'guard_name' => $this->getGuard(),
            'description' => $validated['description'] ?? null,
            'status' => $validated['status'] ?? true,
            'is_system' => false,
        ];
    }

    /**
     * 获取角色选项（按 guard 过滤）
     */
    protected function getRoleOptions(): array
    {
        $roleModel = config('lartrix.models.role', \Lartrix\Models\Role::class);
        return $roleModel::query()
            ->where('status', true)
            ->where('guard_name', $this->getGuard())
            ->get(['name', 'title'])
            ->map(fn ($role) => [
                'label' => $role->title ?: $role->name,
                'value' => $role->name,
            ])
            ->toArray();
    }

    /**
     * 获取权限树（按 guard 过滤）
     */
    protected function getPermissionTree(): array
    {
        $permissionModel = config('lartrix.models.permission', \Lartrix\Models\Permission::class);
        return $permissionModel::query()
            ->where('guard_name', $this->getGuard())
            ->whereNull('parent_id')
            ->with('allChildren')
            ->orderBy('sort')
            ->get()
            ->map(fn ($p) => $this->formatPermissionNode($p))
            ->toArray();
    }
}
